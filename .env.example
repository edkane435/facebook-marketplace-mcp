# Copy to .env (already gitignored) and fill in real values.

# Facebook session cookie header, for hosts with no Chrome/Keychain to
# extract from (Linux, this repo's daily-check script, etc).
# How to get it: open facebook.com in Chrome while logged in, open DevTools
# > Network tab, click any request to facebook.com, find the "cookie:"
# request header, and copy its full value. It must come from the Network
# tab (not document.cookie in the console) because it needs to include
# httpOnly cookies like "xs". Expires periodically — if the daily check
# starts failing, grab a fresh one.
FB_COOKIE_HEADER=""

# Resend (resend.com) for the daily digest email, sent over their HTTP API
# rather than raw SMTP — most cloud hosts (Railway included) block outbound
# SMTP ports by default, so SMTP-based sending just hangs/times out there.
RESEND_API_KEY=""
EMAIL_TO="you@gmail.com"
# Optional — defaults to Resend's shared "onboarding@resend.dev" sender,
# which works without verifying your own domain. Only set this if you've
# verified a domain with Resend and want to send from your own address.
EMAIL_FROM=""

# Where monitors.json/cars.csv are stored. Only needed on hosts with an
# ephemeral filesystem (e.g. Railway) — point it at a mounted volume there.
# Leave unset for local use (defaults to ~/.fb-marketplace).
FB_MARKETPLACE_HOME=""
